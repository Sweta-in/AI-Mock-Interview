# ═══════════════════════════════════════════════════════════════════════════
# PrepAI — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════════

# ── Anthropic (Primary LLM) ─────────────────────────────────────────────
# Sign up: https://console.anthropic.com
# Get API key from: Console → API Keys
ANTHROPIC_API_KEY=

# ── OpenAI (Fallback LLM) ───────────────────────────────────────────────
# Sign up: https://platform.openai.com
# Get API key from: Settings → API Keys
OPENAI_API_KEY=

# ── Supabase (PostgreSQL + Auth + Storage) ──────────────────────────────
# Sign up: https://supabase.com
# Create a project, then find these in: Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_KEY=

# ── PostgreSQL (via Supabase or local Docker) ────────────────────────────
# For local dev with Docker Compose, these defaults work:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prepai
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/prepai

# ── MongoDB Atlas (Interview Transcripts) ────────────────────────────────
# Sign up: https://www.mongodb.com/atlas
# Create a free M0 cluster, then get the connection string
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=prepai

# ── Redis (Upstash or local Docker) ─────────────────────────────────────
# Sign up: https://upstash.com
# Create a Redis database, get the REST URL and token
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Standard Redis URL for Celery broker (local: redis://localhost:6379/0)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── App Configuration ───────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-32-char-string
ALLOWED_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# ── Resend (Transactional Email) ─────────────────────────────────────────
# Sign up: https://resend.com
# Get API key from: Dashboard → API Keys
RESEND_API_KEY=

# ── Frontend (Next.js public vars) ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
